# ==============================================================================
# AWS Client Library - Configuração de Exemplo
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme necessário
#
# PRIORIDADE DE AUTENTICAÇÃO:
# 1. SSO Profile (AWS_PROFILE) - RECOMENDADO
# 2. Cross-Account Role (AWS_CROSS_ACCOUNT_ROLE)
# 3. IAM User (AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)
# 4. Temporary Credentials (com AWS_SESSION_TOKEN)
# 5. Default (IAM role em EC2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 OPÇÃO 1: SSO (IAM Identity Center) - RECOMENDADO
# ------------------------------------------------------------------------------
# Use quando suas credenciais são gerenciadas por AWS SSO
# Execute antes: aws sso login --profile <nome-do-perfil>

AWS_PROFILE=security-account
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 🔐 OPÇÃO 2: Cross-Account Role (AssumeRole)
# ------------------------------------------------------------------------------
# Use quando precisa acessar outra conta AWS

# AWS_CROSS_ACCOUNT_ROLE=arn:aws:iam::123456789012:role/MyRole
# AWS_EXTERNAL_ID=my-secure-external-id
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 🔐 OPÇÃO 3: IAM User (Access Key)
# ------------------------------------------------------------------------------
# Use quando tem credenciais permanentes de um IAM User
# ⚠️  NÃO RECOMENDADO para produção - use SSO ou IAM Roles

# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 🔐 OPÇÃO 4: Temporary Credentials (STS)
# ------------------------------------------------------------------------------
# Use quando tem credenciais temporárias de GetSessionToken

# AWS_ACCESS_KEY_ID=ASIA...
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SESSION_TOKEN=your-session-token
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 🔐 OPÇÃO 5: Default (IAM Role EC2)
# ------------------------------------------------------------------------------
# Não configure nada - role da instância EC2 será usada automaticamente
# AWS_REGION=us-east-1

# ==============================================================================
# 📋 CONFIGURAÇÕES OPCIONAIS
# ==============================================================================

# External ID para AssumeRole (previne "Confused Deputy Problem")
# Use o mesmo valor configurado na Trust Policy da role target
# AWS_EXTERNAL_ID=my-secure-external-id

# ID da conta AWS (opcional - detectado automaticamente)
# AWS_ACCOUNT_ID=123456789012

# ==============================================================================
# 🚀 EXEMPLOS DE USO
# ==============================================================================

# ------------------------------------------------------------------------------
# Exemplo 1: SSO Simples
# ------------------------------------------------------------------------------
# AWS_PROFILE=my-sso-profile
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Exemplo 2: SSO + Cross-Account com External ID
# ------------------------------------------------------------------------------
# AWS_PROFILE=security-account
# AWS_CROSS_ACCOUNT_ROLE=arn:aws:iam::987654321098:role/AuditorRole
# AWS_EXTERNAL_ID=audit-external-id-2024
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Exemplo 3: IAM User + Cross-Account
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_CROSS_ACCOUNT_ROLE=arn:aws:iam::111111111111:role/MyRole
# AWS_EXTERNAL_ID=my-external-id
# AWS_REGION=us-east-1

# ==============================================================================
# 📝 NOTAS IMPORTANTES
# ==============================================================================

# 1. SSO SETUP
#    Antes de usar SSO, configure o perfil em ~/.aws/config:
#    
#    [profile my-sso-profile]
#    sso_start_url = https://my-org.awsapps.com/start
#    sso_region = us-east-1
#    sso_account_id = 123456789012
#    sso_role_name = MyRole
#    region = us-east-1
#
#    E faça login: aws sso login --profile my-sso-profile

# 2. EXTERNAL ID SECURITY
#    O External ID previne o "Confused Deputy Problem"
#    Garanta que o mesmo valor está na Trust Policy da role:
#    
#    {
#      "Effect": "Allow",
#      "Principal": { "AWS": "arn:aws:iam::111111111111:root" },
#      "Action": "sts:AssumeRole",
#      "Condition": {
#        "StringEquals": {
#          "sts:ExternalId": "my-secure-external-id"
#        }
#      }
#    }

# 3. SEGURANÇA
#    - Nunca commite .env no Git (já está no .gitignore)
#    - Use AWS Secrets Manager/Parameter Store em produção
#    - Prefira SSO ou IAM Roles sobre Access Keys
#    - Rotacione External IDs regularmente

# 4. TROUBLESHOOTING
#    - Token SSO expirado: aws sso login --profile <profile>
#    - Perfil não encontrado: aws configure list-profiles
#    - AssumeRole falhou: verifique Trust Policy e External ID
#    - Organizations denied: precisa Management Account ou delegação

# ==============================================================================
# 🔍 VALIDAÇÃO
# ==============================================================================

# Para validar se suas credenciais estão funcionando:
#
# python -c "from AccessBuilder import ConfigLoader; \
#            c = ConfigLoader('.env'); m = c.get_manager(); \
#            m.initialize(); print(m.session.client('sts').get_caller_identity())"

# ==============================================================================
